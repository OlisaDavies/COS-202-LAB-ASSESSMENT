/* The look and feel of SCAPMS.

   The rules are the same as in the first version of the program, they are
   only kept in a resource file now so that they do not take up half of the
   window class. */

QMainWindow {
    background-color: #f7f8fa;
    font-family: 'Segoe UI', Arial, sans-serif;
}

QTabWidget::pane {
    border: 1px solid #dde1e7;
    background: #ffffff;
    border-radius: 8px;
    margin-top: -1px;
}

QTabBar::tab {
    background: #e9edf2;
    color: #5b636e;
    font-weight: 600;
    padding: 10px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #35618f;
    border-top: 3px solid #35618f;
    border-bottom: 1px solid #ffffff;
}

QTabBar::tab:hover:!selected {
    background: #dde1e7;
    color: #25292f;
}

QGroupBox {
    font-weight: 600;
    color: #25292f;
    border: 1px solid #dde1e7;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 14px;
    background: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    color: #35618f;
}

QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #c4ccd6;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    color: #25292f;
    selection-background-color: #35618f;
}

QLineEdit:focus, QComboBox:focus {
    border: 1.5px solid #35618f;
    background: #f7f8fa;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dde1e7;
    border-radius: 6px;
    gridline-color: #eef1f4;
    font-size: 13px;
    color: #5b636e;
}

QTableWidget::item {
    padding: 6px;
    border-bottom: 1px solid #eef1f4;
}

QTableWidget::item:selected {
    background-color: #e6ecf3;
    color: #2a4d72;
}

QHeaderView::section {
    background-color: #f7f8fa;
    color: #5b636e;
    font-weight: 600;
    font-size: 12px;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #dde1e7;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #dde1e7;
    border-radius: 6px;
    padding: 6px;
    font-size: 13px;
    color: #25292f;
}

QListWidget::item {
    padding: 8px 12px;
    margin-bottom: 4px;
    border-radius: 4px;
    background: #f7f8fa;
    border-left: 3px solid #35618f;
}

QStatusBar {
    background: #eef1f4;
    color: #5b636e;
    font-weight: 500;
    font-size: 12px;
    border-top: 1px solid #dde1e7;
}

QTextEdit {
    background: #ffffff;
    border: 1px solid #dde1e7;
    border-radius: 6px;
    padding: 12px;
    color: #25292f;
    font-family: 'Consolas', monospace;
}
